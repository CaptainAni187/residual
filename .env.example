# Copy to .env (gitignored) and fill locally. Never commit real values.
# Test-mode keys only. Live keys must not touch this repo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Optional. Everything runs without it; set it to let the model propose
# hypotheses and write the memo instead of the offline templater.
ANTHROPIC_API_KEY=

# Optional model providers for the agents. Any one is enough; with none,
# everything still runs and explanations come from the verifier's output.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
